# DevSecOps Multi-Agent Configuration

# 1. LLM Provider Setup: 'gemini', 'openai', 'ollama', or 'mock'
LLM_PROVIDER=mock

# 2. Google Gemini API (Recommended: Free key from https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 3. OpenAI API (Alternative)
OPENAI_API_KEY=
HOSTED_LLM_MODEL=gpt-4o-mini

# 4. Local Ollama (Alternative: Self-hosted open-weight models)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen2.5-coder:7b

# 5. Sandbox Execution Environment: 'docker' or 'local'
SANDBOX_DRIVER=docker
